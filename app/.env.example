# Copy to .env (git-ignored) and fill in. Never commit .env.
# Reply interpretation provider: rule (no network) or openai-compatible.
#
# Free option: Google Gemini. Create a key at https://aistudio.google.com/apikey
ONEROOF_AI_PROVIDER=openai-compatible
ONEROOF_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ONEROOF_AI_MODEL=gemini-3.5-flash-lite
ONEROOF_AI_API_KEY=
#
# Other OpenAI-compatible free tiers work the same way, for example Groq:
#   ONEROOF_AI_BASE_URL=https://api.groq.com/openai/v1  ONEROOF_AI_MODEL=<model id from the Groq console>
#
# Demo reset (시연 도우미 > 초기화) is off unless this key is set. Leave it unset on a public deployment.
ONEROOF_DEMO_RESET_KEY=
